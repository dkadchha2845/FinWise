# LLM provider: auto | groq | gemini | mock
#   auto = Groq if GROQ_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else mock (offline)
LLM_PROVIDER=auto
# Seconds between LLM calls (free-tier friendly). 0 = no throttle
LLM_MIN_INTERVAL=0

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
